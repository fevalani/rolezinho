scripts/wrapped-pipeline/output/
scripts/wrapped-pipeline/**/__pycache__/
# fotos curadas copiadas para o front (públicas na web após deploy — só suba de propósito)
public/wrapped/
# Wrapped pipeline — fotos brutas do Google Fotos/Takeout e config pessoal (nomes das pessoas)
scripts/wrapped-pipeline/raw_photos/*
!scripts/wrapped-pipeline/raw_photos/.gitkeep
scripts/wrapped-pipeline/wrapped_config.json
*.tsbuildinfo

